# Personal project only. Replace every placeholder in an ignored .env.local.
# Never use company credentials or commit this file after adding real values.
NODE_ENV=development
PORT=3000
# APP_ORIGIN=http://localhost:3000 (optional; omitted uses the current request host)
APP_PASSWORD=replace-with-your-password
SESSION_SECRET=replace-with-at-least-32-random-characters
BUILD_SHA=replace-with-git-commit-sha

# Server-side private ElevenLabs agent. Never expose these to browser JavaScript.
ELEVENLABS_API_KEY=replace-with-personal-key
ELEVENLABS_AGENT_ID=replace-with-private-agent-id
VOICE_PROVIDER_MAX_SECONDS=300

# Existing personal Neon database. Setup creates isolated epic_chess schema only.
CHESS_QUOTA_DATABASE_URL=replace-with-personal-neon-connection-string
# Voice uses provider credits; no game-side USD budget or monetary reservation.

# Generation/report credentials are local tools only and are not deployed.
# REPLICATE_API_TOKEN=replace-with-personal-key
# MESHY_API_KEY=replace-with-personal-key
